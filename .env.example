# Copier vers .env (jamais commité) et renseigner les valeurs.
# DacRC
URL_DACRC=
USER_DACRC=
PASSWORD_DACRC=
TYPE_DEMANDE=            # recordTypeId de la demande
DEMANDEUR=
DKCODE=
SERVICE=Chauffage
MOTIF=
RAISON_MAJ_URGENCE=TNR
PROPRIETAIRE=Robot RPA

# Dactech
URL_DACTECH=
USER_DACTECH=
PASSWORD_DACTECH=
INTERVENANT_MATRICULE=

# Optionnel
CHROME_PATH=             # ex: C:\robots\chrome\chrome.exe
PROFILE_DIR=             # ex: C:\Temp\profil (profil Chrome persistant ; défaut auth/profile)

# Log Datadog (identique aux autres robots)
DD_ROBOT=                # nom du robot, ex: sc2-supervision
DD_CLIENT=               # ex: Dalkia
DD_APPLICATION=          # ex: DacRC-Dactech
DD_LOG_DIR=              # défaut C:/logs
REPORT_FILE=             # chemin du rapport (UNC \\wdkrpap01\shared_files\results\... => converti en URL)
