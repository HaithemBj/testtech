{
  "name": "sc2-playwright",
  "version": "1.0.0",
  "description": "Parcours B2B DacRC => Dactech en pur Playwright (conversion de sc2_b2b_dacrc_dactech.robot)",
  "private": true,
  "scripts": {
    "auth": "playwright test --project=auth",
    "test": "playwright test --project=main",
    "test:headed": "playwright test --project=main --headed",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^26.6.6",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=26"
  }
}
